# ============================================================
# WE MOVE IT. WE CLEAR IT. — Environment Variables
# Copy this file to .env.local for local dev
# NEVER commit .env.local or .env to git
# ============================================================

# ── APP ─────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://wmiwci-backend.vercel.app
APP_URL=http://localhost:3000

# Cookie domain (leave empty for localhost, set for production)
# Production: .moveitclearit.com    
COOKIE_DOMAIN=

s

# ── DATABASE ─────────────────────────────────────────────────
# Supabase / Neon / Railway / PlanetScale URL
# Example (Supabase): postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/moveit_dev
# Separate shadow DB for Prisma migrations
SHADOW_DATABASE_URL=postgresql://postgres:password@localhost:5432/moveit_shadow

# ── REDIS ────────────────────────────────────────────────────
# Upstash (recommended for Vercel): https://console.upstash.com
# Self-hosted: redis://localhost:6379
REDIS_URL="redis://default:REPLACE_ME@your-instance.upstash.io:6379"
# Upstash REST API (used by @upstash/ratelimit on edge)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REPLACE_ME"

# ── AUTH / JWT ───────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_EXPIRY=7d

# CSRF secret — generate with: openssl rand -hex 32
CSRF_SECRET=REPLACE_WITH_32_CHAR_RANDOM_SECRET

# ── OWNER CREDENTIALS (Diego) ────────────────────────────────
# Hash with: npx tsx scripts/hash-password.ts YOUR_PASSWORD
OWNER_EMAIL=diego@moveitclearit.com
OWNER_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# Manager credentials (Sebastian)
MANAGER_EMAIL=sebastian@moveitclearit.com
MANAGER_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# ── STRIPE ───────────────────────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Webhook secret from: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Set to "true" ONLY for a deliberate test-mode launch on prod infra (Vercel
# forces NODE_ENV=production). Leave unset/false in real production with sk_live_.
STRIPE_ALLOW_TEST=false
# Booking fee amount in cents ($49.00)
STRIPE_BOOKING_FEE_CENTS=4900

# ── DISCORD ──────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=REPLACE_ME
# Application ID from Developer Portal → General Information
DISCORD_APPLICATION_ID=REPLACE_ME
# Public Key from Developer Portal → General Information
DISCORD_PUBLIC_KEY=REPLACE_ME
# Your server (guild) ID (right-click server → Copy Server ID)
DISCORD_GUILD_ID=REPLACE_ME

# Channel IDs (right-click channel → Copy Channel ID after enabling Developer Mode)
DISCORD_CHANNEL_JOBS=REPLACE_ME
DISCORD_CHANNEL_PAPERWORK=REPLACE_ME
DISCORD_CHANNEL_PHOTOS=REPLACE_ME
DISCORD_CHANNEL_PAYMENTS=REPLACE_ME
DISCORD_CHANNEL_RECEIPTS=REPLACE_ME
DISCORD_CHANNEL_SCHEDULING=REPLACE_ME
DISCORD_CHANNEL_OPERATIONS=REPLACE_ME
DISCORD_CHANNEL_NEWS=REPLACE_ME
DISCORD_CHANNEL_BOT_LOGS=REPLACE_ME

# Staff Discord user IDs (right-click user → Copy User ID)
DISCORD_USER_DIEGO=REPLACE_ME
DISCORD_USER_SEBASTIAN=REPLACE_ME

# ── DEPOSIT-LINK PAYMENT NOTIFICATIONS (owner spec 2026-08-15) ────────────────
# Where a CONFIRMED deposit payment is announced. Two transports; the first one
# configured wins.
#
#   1. DISCORD_PAYMENTS_WEBHOOK_URL — an INCOMING WEBHOOK created inside the
#      target channel (Channel → Edit Channel → Integrations → Webhooks → New).
#      Preferred when present: only a webhook can carry the "Move It Clear It
#      Payments" sender name and the company logo avatar.
#
#      ** THIS URL IS A SECRET. ** Anyone holding it can post to that channel as
#      the company. Set it in the host dashboard only. Never commit it, never log
#      it, never put it in the database, never expose it to a browser.
#
#   2. DISCORD_BOT_TOKEN (already set above) + DISCORD_PAYMENTS_CHANNEL_ID —
#      the existing bot posts to the channel directly. Used automatically when no
#      webhook URL is set.
#
# A CHANNEL ID ALONE CANNOT AUTHENTICATE ANYTHING. With neither a webhook URL
# nor a bot token, payments still complete and are still recorded, but no Discord
# message is sent and the admin page says so plainly.
DISCORD_PAYMENTS_WEBHOOK_URL=
# The owner-designated payments channel. This exact id is also the built-in
# default (src/lib/deposit-notify.ts), so the bot transport works without it.
DISCORD_PAYMENTS_CHANNEL_ID=1524853745064869990
# Optional: absolute URL of the webhook avatar. Defaults to ${APP_URL}/logo/icon.png
DISCORD_PAYMENTS_AVATAR_URL=

# ── DEPOSIT LINKS: public URL + social card ───────────────────────────────────
# The base the customer-facing link is built on. LEAVE THIS EMPTY until
# https://moveitclearit.com/deposit/* is actually proxied to this app — links
# then fall back to APP_URL, which definitely serves the page. A pretty URL that
# 404s is worse than an ugly one that works.
DEPOSIT_LINK_BASE_URL=
# Optional override for the 1200x630 og:image on /deposit/*. Defaults to
# ${APP_URL}/assets/social/move-it-clear-it-deposit-v1.jpg, which ships in this
# repo's public/ so it always deploys with the page it describes.
DEPOSIT_OG_IMAGE_URL=

# ── OWNER PERMISSIONS (who can approve/deny/manage bookings from Discord) ──────
# A user is an authorized owner when EITHER of these is true inside DISCORD_GUILD_ID:
#   • their user ID is in this comma-separated allowlist, OR
#   • they hold the owner role below.
# Add a new manager by appending their user ID here (or granting them the role) —
# no code change needed. Legacy DISCORD_USER_DIEGO / DISCORD_USER_SEBASTIAN above
# are also honored as owners for backward compatibility.
# Example: DISCORD_OWNER_USER_IDS=123456789012345678,901897768937869332
DISCORD_OWNER_USER_IDS=REPLACE_ME
# The Discord role that grants owner powers (right-click role → Copy Role ID).
# Anyone with this role can perform every owner action. Leave blank to gate on
# user IDs only.
DISCORD_OWNER_ROLE_ID=REPLACE_ME

# ── RESEND (Email) ────────────────────────────────────────────
# Get key at https://resend.com
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=Move It Clear It <hello@moveitclearit.com>
EMAIL_REPLY_TO=hello@moveitclearit.com

# ── CLOUDINARY (File Storage) ─────────────────────────────────
# Get from https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# ── TWILIO (SMS) — WIRED, INACTIVE until keys added ──────────
TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_PHONE_NUMBER=+1REPLACE_ME
# Set to "true" to activate SMS sending
TWILIO_ENABLED=false

# ── CLOUDFLARE TURNSTILE — WIRED, INACTIVE ───────────────────
# Get from https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME
# Set to "true" to enforce CAPTCHA
TURNSTILE_ENABLED=false

# ── SENTRY — WIRED, INACTIVE ─────────────────────────────────
# Get from https://sentry.io
SENTRY_DSN=REPLACE_ME
NEXT_PUBLIC_SENTRY_DSN=REPLACE_ME
# Set to "true" to activate Sentry
SENTRY_ENABLED=false

# ── SCHEDULING ────────────────────────────────────────────────
TIMEZONE=America/New_York
MAX_JOBS_PER_DAY=3
TRAVEL_BUFFER_MINUTES=60
MIN_BOOKING_NOTICE_HOURS=24

# ── SECURITY ──────────────────────────────────────────────────
# Max booking attempts per IP per hour
RATE_LIMIT_BOOKING=5
# Max login attempts per IP per 15 minutes
RATE_LIMIT_LOGIN=10

# ── MOVING SERVICE AGREEMENT ─────────────────────────────────
# Version stamp stored on every booking for legal traceability.
# Bump when you change the agreement text in src/lib/agreement.ts.
# Optional — defaults to "v1-2026-05" if unset.
AGREEMENT_VERSION=v1-2026-05

# ── GLOBAL EMAIL KILL SWITCH (owner spec 2026-07-24) ─────────────────────────
# The single flag that stops EVERY customer email at the canonical choke point
# guardedSend() — transactional, quote follow-ups, journeys, automations,
# campaigns, post-move, admin test sends, outbox + BullMQ worker sends. Blocked
# sends are recorded as DEFERRALS (no provider call) and resume automatically
# when the switch is turned back on. Only the literal string "false" disables
# sending, so an unset var never breaks the transactional mail that already
# works. Internal owner/ops alerts to OWNER_EMAIL are intentionally NOT gated
# (you still get incident alerts while customer mail is off).
#   EMAIL_SENDING_ENABLED=false   → emergency stop for all customer email
#   (unset / any other value)     → normal sending
EMAIL_SENDING_ENABLED=true

# ── PARTIAL BOOKING LEAD CAPTURE (owner spec 2026-07-24) — WIRED, INACTIVE ────
# Master switch for POST /api/leads/partial (the booking form captures a lead the
# instant a valid email is entered in Step 1). When NOT "true", the route writes
# nothing and returns {ok:true,skipped:'flag_off'} — the booking form behaves
# exactly as before. Turn on only AFTER the additive migration
# (20260724000000_partial_lead_capture) is applied. The static site also has its
# own client mirror constant (PARTIAL_LEAD_CAPTURE_ENABLED in booking-form.html).
PARTIAL_BOOKING_EMAIL_CAPTURE_ENABLED=false

# ── LEAD HYGIENE / RETENTION (owner review 2026-07-24) ───────────────────────
# Daily cron ('lead-maintenance', 3:20 AM ET) ages inactive partial captures to
# lifecycle ABANDONED, then purges long-abandoned ones. BOTH steps skip any lead
# that was quoted, booked, converted, or that carries a consent decision — and
# EmailSuppression/unsubscribe records are in a separate table and never touched.
# Days of inactivity before a partial capture becomes ABANDONED (default 14).
LEAD_ABANDON_AFTER_DAYS=14
# Days an ABANDONED lead is retained before deletion. Set 0 to DISABLE purging.
LEAD_PURGE_AFTER_DAYS=180

# ── MARKETING AUTOMATION (external tool) — WIRED, INACTIVE ────
# Used by src/lib/marketing.ts to enroll paying customers into your
# email/CRM tool (Mailchimp/HubSpot/Klaviyo/etc.). Until BOTH are set,
# the marketing step no-ops safely (logs "skipping").
MARKETING_API_KEY=REPLACE_ME
MARKETING_LIST_ID=REPLACE_ME

# ── LINKS ─────────────────────────────────────────────────────
# URL of the marketing site (for cancel redirect, etc.)
MARKETING_SITE_URL=https://moveitclearit.com

# Bull Board UI — run as standalone Express app on internal port 3001
# Leave empty to disable redirect from /api/admin/queues/bull-board
BULL_BOARD_URL=

# ── EMAIL OUTBOX (src/outbox) ────────────────────────────────
# Master switch. When "true", payment/approve/reschedule trigger points emit
# events to the outbox (which sends the email) and the email at that point is
# skipped — never both. Default OFF = behavior unchanged. Run the migration
# (npx prisma migrate deploy) BEFORE turning this on.

# ── EMAIL LIFECYCLE (owner spec 2026-07-20) ──────────────────────────────
# Signing secret for unsubscribe / preference links. If unset it is DERIVED
# from RESEND_API_KEY; in production with a placeholder Resend key, signing
# THROWS rather than sign links with a known dev secret. Set a real value.
EMAIL_TOKEN_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET

# Resend webhook signing secret (Svix). WITHOUT THIS the webhook returns 503
# and bounces/complaints are NEVER processed — promotional sending is unsafe.
# Resend dashboard -> Webhooks -> endpoint {APP_URL}/api/email/webhook
RESEND_WEBHOOK_SECRET=whsec_REPLACE_ME

# Shared secret for /api/email/suppression, so Leadtracking (SendGrid) and this
# system honour ONE opt-out list. Unset = the endpoint is DISABLED (503), not open.
EMAIL_SUPPRESSION_API_KEY=REPLACE_ME

# Physical postal address on PROMOTIONAL mail. CAN-SPAM requires it.
# ENFORCED, not advisory: guardedSend() BLOCKS every promotional send while this
# is unset or still a placeholder, and names it in the block reason. No default
# exists and none is invented — a made-up address is worse than none.
# Set it to the real registered business address.
BUSINESS_POSTAL_ADDRESS=REPLACE_ME

# Attempt state machine (findings EMAIL-P1-03 / EMAIL-P1-04).
# Max attempts against ONE logical send before it becomes failed_terminal.
EMAIL_MAX_SEND_ATTEMPTS=5
# How long a send may sit mid-flight before another worker may take it over.
EMAIL_SENDING_STALE_MS=600000

# Lifecycle journeys. OFF unless explicitly true. Disable one at a time with
# EMAIL_JOURNEY_<NAME>_DISABLED=true (ABANDONED | REMINDERS | QUOTE).
EMAIL_JOURNEYS_ENABLED=false

# Campaign dispatch + custom automations (the PROMOTIONAL master switch).
# OFF, fail closed: campaign dispatch refuses and automation stages hold
# (enrollments kept, never lost) until this is deliberately enabled AFTER the
# staging rehearsal passes (docs/email/dispatch-staging-rehearsal.md).
EMAIL_PROMOTIONS_ENABLED=false
# The ONE address test sends may go to (Test-send tab refuses without it).
EMAIL_TEST_RECIPIENT=team@example.com
# Campaign batching + stale-claim recovery (optional; defaults shown).
EMAIL_CAMPAIGN_BATCH_SIZE=25
EMAIL_CAMPAIGN_STALE_MS=900000

# Referral programme. The 10-rule eligibility gate also requires a completed
# Stripe payment + a durable AuditLog(RECEIPT_SENT) event.
REFERRAL_PROGRAM_ENABLED=false
REFERRAL_REQUIRE_STRIPE=true
REFERRAL_URL=https://www.moveitclearit.com/refer
REFERRAL_CODE=REFER15

# Frequency caps + quiet hours. PROMOTIONAL mail only — transactional booking
# mail is exempt by design (a receipt must arrive when the event happens).
EMAIL_CAP_PER_DAY=1
EMAIL_CAP_PER_WEEK=3
EMAIL_CAP_PER_MONTH=6
EMAIL_QUIET_END_HOUR=8
EMAIL_QUIET_START_HOUR=21
EMAIL_TRANSACTIONAL_GAP_MINUTES=60

# Post-move follow-ups (review / repeat / referral).
MARKETING_FOLLOWUPS_ENABLED=false
GOOGLE_REVIEW_URL=REPLACE_ME

# Hosted email images (hero + icons).
EMAIL_ASSET_BASE_URL=https://moveitclearit.com/email

OUTBOX_ENABLED=false
# Log emails instead of sending them (test the pipeline without real mail).
OUTBOX_EMAIL_DRYRUN=false
# Worker tuning (run: tsx src/outbox/workers/emailWorker.ts)
OUTBOX_POLL_MS=3000
OUTBOX_BATCH=20
# A job stuck in 'processing' longer than this (crashed worker) is requeued.
OUTBOX_STALE_PROCESSING_MS=300000
# Send the optional NEW_DATE_PICKED email (default: just re-post the Discord card)
OUTBOX_SEND_DATE_PICKED=false

# ── CONTROLLED TEST PAYMENTS (staging only; owner spec 2026-07-15) ──────────────
# OFF by default. When 'true', the OWNER-only POST /api/admin/test-booking can
# create a flagged internal-test booking with a small controlled deposit (below)
# instead of the real $49 — for verifying authorize/approve/capture/refund WITHOUT
# touching public pricing. Never set this in normal production. Unset to disable.
ALLOW_TEST_PAYMENTS=false
# Controlled test amount in CENTS (default 100 = $1). Clamped to [50, 4900].
TEST_PAYMENT_AMOUNT_CENTS=100

# ════════════════════════════════════════════════════════════════════════
#  EMAIL OPERATIONS AGENT (owner spec 2026-07-28)
#  ---------------------------------------------------------------------
#  Watches the email-marketing system, groups problems into incidents, and
#  asks before touching anything that reaches a customer.
#
#  WHERE THESE GO: the WORKER service needs all of them (it runs the cycle).
#  The WEB service needs only DATABASE_URL, EMAIL_AGENT_ENABLED and the
#  heartbeat token — it renders status and handles approvals; it never runs a
#  cycle. Giving the web service a provider key it cannot use is a needless
#  place for a key to leak.
# ════════════════════════════════════════════════════════════════════════

# The master switch. WITHOUT THIS SET TO "true" THE AGENT DOES NOTHING,
# whatever the database row says.
EMAIL_AGENT_ENABLED=false

# off | read_only | safe_auto
#   read_only  — watches, reports, alerts. Executes NOTHING. Production value.
#   safe_auto  — adds narrow, policy-approved repairs. NOT approved for use.
EMAIL_AGENT_MODE=read_only

# How often the deterministic cycle runs. The checks cost nothing; the AI is
# separately gated by the budget and by change-detection.
EMAIL_AGENT_INTERVAL_MINUTES=15

# ── AI provider ────────────────────────────────────────────────────────
# deepseek-v4-flash is the cheapest model that passes the decision-quality and
# schema checks. gpt-5.4-nano is the fallback: nano answers without the
# reasoning-token overhead that makes gpt-5-mini cost more for a task that is
# classification. Verified live against both APIs on 2026-07-28.
EMAIL_AGENT_PROVIDER=deepseek
EMAIL_AGENT_MODEL=deepseek-v4-flash
EMAIL_AGENT_FALLBACK_PROVIDER=openai
EMAIL_AGENT_FALLBACK_MODEL=gpt-5.4-nano
EMAIL_AGENT_ALLOW_PROVIDER_FALLBACK=true

# Provider keys. Only the worker service needs these.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ── AI budget. Hard ceilings, enforced atomically across containers. ────
# The agent CANNOT raise these itself; there is no tool that writes them.
EMAIL_AGENT_MAX_MODEL_CALLS_PER_CYCLE=2
EMAIL_AGENT_MAX_MODEL_CALLS_PER_DAY=25
EMAIL_AGENT_MAX_TOKENS_PER_DAY=150000
EMAIL_AGENT_MAX_TOKENS_PER_MONTH=3000000
EMAIL_AGENT_MAX_AI_COST_USD_PER_DAY=0.20
EMAIL_AGENT_MAX_AI_COST_USD_PER_MONTH=3.00
# Hours before an UNCHANGED incident may be investigated again. This is the
# single biggest cost control: without it an open incident costs a model call
# every cycle forever.
EMAIL_AGENT_AI_REINVESTIGATE_HOURS=12
# Ceiling on answer tokens. Output is the expensive half of the bill.
EMAIL_AGENT_MAX_OUTPUT_TOKENS=1200

# ── Action limits. Enforced now, though safe_auto is off. ──────────────
EMAIL_AGENT_MAX_AUTO_ACTIONS_PER_RUN=3
EMAIL_AGENT_MAX_AUTO_ACTIONS_PER_DAY=10
EMAIL_AGENT_MAX_AUTO_ACTIONS_PER_TOOL_DAY=4
EMAIL_AGENT_MAX_AUTO_ACTIONS_PER_INCIDENT=3
EMAIL_AGENT_RESOURCE_ACTION_COOLDOWN_MINUTES=60
EMAIL_AGENT_AUTO_FAILURE_DOWNGRADE_THRESHOLD=3
EMAIL_AGENT_STAGE_RECIPIENT_LIMIT=50

# ── External dead-man heartbeat ────────────────────────────────────────
# A dead worker cannot report its own death. Point an external uptime monitor
# at GET /api/email/agent-heartbeat with this token; it returns 503 when the
# worker is stale or failing, so a plain HTTP check is enough.
# Minimum 16 characters. Without it the endpoint is DISABLED, not public.
EMAIL_AGENT_HEARTBEAT_TOKEN=

# ── Local-development safety ───────────────────────────────────────────
# A local runtime pointed at the production database is REFUSED by default:
# findings produced on a laptop describe the laptop, and a missing local
# variable would otherwise become a production compliance incident. Set this
# only when you genuinely mean to write to production from your machine.
ALLOW_EMAIL_AGENT_PRODUCTION_WRITES=false

# Optional overrides. Normally inferred from RAILWAY_* — set only for a
# non-Railway deployment that still needs correct provenance.
# EMAIL_AGENT_ENVIRONMENT=production
# EMAIL_AGENT_SERVICE=worker
